# =============================================================
# STECH BACKEND - PERFIL REAL
# Copiar como .env. NUNCA subir .env ni secretos a GitHub.
# =============================================================

STECH_PROFILE=real
HOST=127.0.0.1
PORT=3000

# ---------------- OPENAI / LLM REAL ----------------
LLM_MODE=openai
# La misma API key se usa para planner/writer y embeddings.
OPENAI_API_KEY=REEMPLAZAR_OPENAI_API_KEY
OPENAI_MODEL=REEMPLAZAR_MODELO_OPENAI
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------- ERP / SQL ----------------
ERP_MODE=sql-bridge
SQL_BRIDGE_URL=REEMPLAZAR_URL_WEBHOOK_SQL_BRIDGE_V2
SQL_BRIDGE_TOKEN=REEMPLAZAR_TOKEN_SQL_BRIDGE
SQL_CATALOG_PROCEDURE=dbo.sp_BuscarProductosVenta

# ---------------- PERSISTENCIA SUPABASE REAL ----------------
PERSISTENCE_MODE=supabase
SUPABASE_URL=REEMPLAZAR_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZAR_SERVICE_ROLE_KEY
SUPABASE_SESSION_TABLE=ia_sesiones
SUPABASE_CONTEXT_TABLE=ia_contexto
SUPABASE_CONVERSATION_TABLE=ia_conversaciones
SUPABASE_TOKEN_METRICS_TABLE=ia_metricas_tokens

# ---------------- CONOCIMIENTO SUPABASE ----------------
# Query embeddings -> pgvector/HNSW -> evidencia filtrada por producto/sección.
# Si embedding/RPC falla, el adapter conserva fallback lexical seguro.
RAG_MODE=supabase
SUPABASE_RAG_RPC=buscar_rag_producto_documents_v37

# ---------------- n8n EVENT GATEWAY ----------------
N8N_MODE=n8n
N8N_WEBHOOK_URL=REEMPLAZAR_WEBHOOK_N8N_EVENT_GATEWAY
N8N_WEBHOOK_TOKEN=REEMPLAZAR_TOKEN_WEBHOOK_N8N_EVENT_GATEWAY
N8N_STRICT=false

# ---------------- WHATSAPP CLOUD API ----------------
# Configurar valores reales solo en .env local. Nunca subir el Access Token.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0

# ---------------- LIVE QA ----------------
QA_BASE_URL=http://127.0.0.1:3000
QA_STRICT=false

CHAT_SESSION_ID=prueba-stech-real
