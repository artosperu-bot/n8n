# =============================================================
# STECH BACKEND - PERFIL REAL
# Copiar como .env. NUNCA subir .env ni secretos a GitHub.
# =============================================================

STECH_PROFILE=real
HOST=127.0.0.1
PORT=3000

# ---------------- OPENAI / LLM REAL ----------------
LLM_MODE=openai
OPENAI_API_KEY=REEMPLAZAR_OPENAI_API_KEY
OPENAI_MODEL=REEMPLAZAR_MODELO_OPENAI

# ---------------- ERP / SQL ----------------
# RECOMENDADO PARA TU ENTORNO ACTUAL: reutilizar el SQL Bridge n8n que ya funciona.
ERP_MODE=sql-bridge
SQL_BRIDGE_URL=REEMPLAZAR_URL_WEBHOOK_SQL_BRIDGE_V2
SQL_BRIDGE_TOKEN=REEMPLAZAR_TOKEN_SQL_BRIDGE
SQL_CATALOG_PROCEDURE=dbo.sp_BuscarProductosVenta

# Alternativa futura: SQL Server directo desde Node.
# ERP_MODE=sqlserver
# SQL_SERVER_HOST=REEMPLAZAR_HOST_O_IP_SQLSERVER
# SQL_SERVER_PORT=1433
# SQL_SERVER_DATABASE=REEMPLAZAR_BASE_DATOS
# SQL_SERVER_USER=REEMPLAZAR_USUARIO_SQL
# SQL_SERVER_PASSWORD=REEMPLAZAR_PASSWORD_SQL
# SQL_SERVER_ENCRYPT=false
# SQL_SERVER_TRUST_CERT=true

# ---------------- ESTADO / RAG ----------------
PERSISTENCE_MODE=memory
RAG_MODE=disabled

# ---------------- n8n EVENT GATEWAY ----------------
# Este es OTRO webhook: recibe eventos del backend, no consultas SQL.
N8N_MODE=n8n
N8N_WEBHOOK_URL=REEMPLAZAR_WEBHOOK_N8N_EVENT_GATEWAY
N8N_WEBHOOK_TOKEN=REEMPLAZAR_TOKEN_WEBHOOK_N8N_EVENT_GATEWAY
N8N_STRICT=false

# ---------------- SUPABASE (OPCIONAL / SIGUIENTE ETAPA) ----------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STATE_TABLE=ia_sesiones
SUPABASE_SESSION_ID_COLUMN=session_id
SUPABASE_STATE_COLUMN=estado_backend
SUPABASE_RAG_RPC=match_documents

CHAT_SESSION_ID=prueba-stech-real
